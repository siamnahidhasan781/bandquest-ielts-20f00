{
  "dependencies": {
    "expo": "~51.0.0",
    "expo-av": "~14.0.0",
    "expo-secure-store": "~13.0.0",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "react-native-screens": "~4.4.0",
    "react-native-safe-area-context": "4.10.5",
    "react-native-markdown-display": "^7.0.2",
    "expo-auth-session": "~6.0.2",
    "expo-crypto": "~13.0.2",
    "expo-speech": "~12.0.2",
    "expo-constants": "~16.0.2",
    "expo-file-system": "~17.0.1"
  },
  "description": "BandQuest IELTS mobile app (Expo / React Native). Shares API contracts with the web backend.",
  "devDependencies": {
    "@types/react": "~18.2.0",
    "typescript": "~5.3.0"
  },
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f1f3d",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.bandquest.ielts"
    },
    "extra": {
      "apiUrl": "https://preeminent-crisp-f9941d.netlify.app",
      "googleClientId": ""
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.bandquest.ielts",
      "supportsTablet": true
    },
    "name": "BandQuest IELTS",
    "orientation": "portrait",
    "plugins": [
      "expo-av",
      "expo-secure-store"
    ],
    "slug": "bandquest-ielts",
    "splash": {
      "backgroundColor": "#0f1f3d",
      "image": "./assets/splash.png"
    },
    "version": "1.0.0",
    "scheme": "bandquest"
  },
  "name": "bandquest-ielts-mobile",
  "private": true,
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "eas-build": "eas build --platform android --profile production"
  },
  "version": "1.0.0"
}
